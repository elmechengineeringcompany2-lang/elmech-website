---
// src/layouts/Layout.astro
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Elmech Engineering Company"} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- OpenGraph Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-800 font-sans antialiased flex flex-col min-h-screen selection:bg-blue-600 selection:text-white">
    <header class="border-b border-slate-200/80 bg-white/90 backdrop-blur-xl sticky top-0 z-50 shadow-sm transition-all">
      <div class="container mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="group flex items-center gap-2.5 min-w-0" aria-label="Elmech Engineering Company">
          <img src="/logo-mark.png" alt="" width="140" height="154" class="h-11 w-auto md:h-14 shrink-0 transition-transform duration-300 group-hover:scale-105" />
          <span class="leading-none">
            <span class="block text-lg md:text-[1.65rem] font-black tracking-tight text-slate-900">ELMECH</span>
            <span class="mt-1 block text-[10px] md:text-xs font-semibold italic tracking-wide text-slate-500">Engineering Company</span>
          </span>
        </a>
        <nav class="hidden lg:flex gap-8 font-semibold text-slate-600 items-center">
          <a href="/about" class="hover:text-blue-600 transition-colors py-2">About Us</a>
          <a href="/products" class="hover:text-blue-600 transition-colors py-2">Products</a>

          <!-- Downloads Dropdown -->
          <div class="relative group py-2">
            <button class="flex items-center gap-1 hover:text-blue-600 transition-colors focus:outline-none">
              Downloads
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
            </button>
            <div class="absolute top-full left-0 mt-0 pt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
              <div class="bg-white border border-slate-200 rounded-xl shadow-xl overflow-hidden py-2">
                <a href="/downloads/catalogue" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 font-medium transition-colors">Product Catalogue</a>
                <a href="/downloads/test-certificate" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 font-medium transition-colors">Generate Test Certificate</a>
              </div>
            </div>
          </div>

          <a href="/contact" class="hover:text-blue-600 transition-colors py-2">Contact</a>
        </nav>
        <a href="/#rfq" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg font-semibold transition-all shadow-md hover:shadow-lg hover:shadow-blue-500/20 hover:-translate-y-0.5">Get a Quote</a>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-300 border-t border-slate-800 pt-16 pb-12 relative overflow-hidden">
      <!-- Footer subtle ambient gradient -->
      <div class="absolute bottom-0 left-0 w-full h-full bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-blue-900/20 via-transparent to-transparent pointer-events-none"></div>
      
      <div class="container mx-auto px-4 text-center md:text-left grid grid-cols-1 md:grid-cols-4 gap-10 relative z-10">
        <div class="md:col-span-1">
          <h3 class="text-xl font-bold text-white mb-4 tracking-wide">ELMECH ENGINEERING<span class="text-blue-500">.</span></h3>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">
            Specializing in technical excellence, manufacturing premium reduction gears, worm gearboxes, helical geared motors, and industrial power transmission systems.
          </p>
          <span class="inline-block bg-blue-900/50 text-blue-300 text-xs font-semibold px-3 py-1 rounded border border-blue-500/30">
            Transmech Series
          </span>
        </div>
        <div>
          <h4 class="text-base font-bold text-white mb-5 uppercase tracking-wider">Our Products</h4>
          <ul class="text-slate-400 space-y-2.5 text-sm font-medium">
            <li><a href="/products#worm-gearbox" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Worm Gearbox</a></li>
            <li><a href="/products#helical-gear-motor" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Helical Gear Motor / Gearbox</a></li>
            <li><a href="/products#parallel-shaft-helical" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Parallel Shaft Helical Gearbox</a></li>
            <li><a href="/products#planetary-gearbox" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Planetary Gearbox</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-base font-bold text-white mb-5 uppercase tracking-wider">Quick Links</h4>
          <ul class="text-slate-400 space-y-2.5 text-sm font-medium">
            <li><a href="/about" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>About Us</a></li>
            <li><a href="/downloads/catalogue" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>PDF Downloads & Specs</a></li>
            <li><a href="/industries" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Industries Served</a></li>
            <li><a href="/contact" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Contact Us</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-base font-bold text-white mb-5 uppercase tracking-wider">Factory & Office</h4>
          <p class="text-slate-400 text-sm leading-relaxed mb-3">
            Plot no-83/7, G.I.D.C., Phase-I, 'F' Road,<br />
            Nr. Kotak Mahindra Bank, Vatva,<br />
            Ahmedabad, Gujarat, India
          </p>
          <p class="text-slate-300 text-sm font-medium space-y-1 flex flex-col">
            <a href="tel:+919825083051" class="hover:text-blue-400 transition-colors">+91-9825083051</a>
            <a href="tel:+919824017215" class="hover:text-blue-400 transition-colors">+91-9824017215</a>
            <a href="tel:+917922742267" class="hover:text-blue-400 transition-colors">+91-79-22742267</a>
            <a href="mailto:elmecheng@yahoo.co.in" class="hover:text-blue-400 transition-colors">elmecheng@yahoo.co.in</a>
          </p>
          <p class="text-slate-400 text-xs mt-3">Office Hours: 09:30 AM – 06:00 PM (Mon - Sat)</p>
        </div>
      </div>
      <div class="container mx-auto px-4 mt-12 pt-6 border-t border-slate-800 text-center text-slate-500 text-sm font-medium relative z-10">
        &copy; {new Date().getFullYear()} Elmech Engineering Company. All rights reserved. Precision Power Transmission Systems.
      </div>
    </footer>
  </body>
</html>

<style is:global>
  html {
    font-family: 'Inter', sans-serif;
    scroll-behavior: smooth;
    color-scheme: light;
  }
  
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: #f1f5f9; /* slate-100 */
  }
  ::-webkit-scrollbar-thumb {
    background: #cbd5e1; /* slate-300 */
    border-radius: 5px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #94a3b8; /* slate-400 */
  }
</style>
