---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Product Configurator | Elmech Engineering" description="Configure and build your custom Elmech gearbox online.">
  <section class="relative py-24 border-b border-slate-200 overflow-hidden bg-slate-900">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1565261394747-0e69128f731f?q=80&w=2000&auto=format&fit=crop" alt="Gear Engineering Machinery" class="w-full h-full object-cover filter brightness-90 contrast-105" />
    </div>
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[1px] z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/50 via-slate-900/30 to-slate-900/60 z-0"></div>
    
    <div class="container mx-auto px-4 relative z-10 text-center">
      <div class="max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 bg-white/15 border border-white/25 text-blue-300 font-bold px-4 py-1.5 rounded-full mb-4 text-xs uppercase tracking-wider backdrop-blur-md shadow-sm">
          Interactive Design Tool
        </div>
        <h1 class="text-4xl md:text-6xl font-black text-white mb-4 tracking-tight drop-shadow-lg">Product <span class="text-blue-400">Configurator</span></h1>
        <p class="text-lg md:text-xl text-slate-200 font-medium max-w-2xl mx-auto drop-shadow-md">
          Design and specify the exact gearbox for your application using our interactive tool.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50 min-h-[40vh] flex items-center justify-center">
    <div class="text-center">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-100 text-blue-700 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      </div>
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Section Under Construction</h2>
      <p class="text-slate-600">The interactive 3D configurator is currently in development. Check back soon.</p>
    </div>
  </section>
</Layout>
