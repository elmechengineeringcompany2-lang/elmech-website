---
import Layout from '../../layouts/Layout.astro';
import { catalogProducts, getProductBySlug } from '../../data/products';

export function getStaticPaths() {
  return catalogProducts.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug ?? "");

if (!product) {
  return Astro.redirect("/products");
}
---

<Layout title={`${product.name} | Elmech Engineering Company`} description={`${product.name} in the ${product.familyName} range from Elmech Engineering.`}>
  <section class="relative py-20 border-b border-slate-200 overflow-hidden bg-slate-900">
    <div class="absolute inset-0 z-0">
      <img src={product.imageUrl} alt={product.name} class="w-full h-full object-cover filter brightness-90 contrast-105" />
    </div>
    <div class="absolute inset-0 bg-slate-900/50 z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/70 via-slate-900/40 to-transparent z-0"></div>

    <div class="container mx-auto px-4 relative z-10">
      <a href={`/products#${product.familyId}`} class="inline-flex items-center gap-2 text-blue-300 font-semibold text-sm mb-6 hover:text-blue-200 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        {product.familyName}
      </a>
      <h1 class="text-4xl md:text-6xl font-black text-white mb-4 tracking-tight drop-shadow-lg">{product.name}</h1>
      <p class="text-lg md:text-xl text-slate-200 font-medium max-w-2xl drop-shadow-md">{product.summary}</p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 md:p-10">
        <p class="text-xs font-bold uppercase tracking-wider text-blue-700 mb-3">{product.familyName}</p>
        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-4 tracking-tight">{product.name}</h2>
        <p class="text-slate-600 font-medium leading-relaxed mb-8">
          Ratings, ratios, and mounting details for this unit are available on request. Share your application and our engineers will match the right size.
        </p>
        <a href="/#rfq" class="inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-semibold transition-all shadow-sm">
          Request a Quote
        </a>
      </div>
    </div>
  </section>
</Layout>
