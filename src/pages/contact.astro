---
import Layout from '../layouts/Layout.astro';
import RFQForm from '../components/RFQForm.astro';
---

<Layout title="Contact Us | Elmech Engineering" description="Get in touch with our engineering team for technical support and quotes.">
  <section class="relative py-20 border-b border-slate-200 overflow-hidden bg-slate-900">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=2000&auto=format&fit=crop" alt="Engineering Support" class="w-full h-full object-cover filter brightness-90 contrast-105" />
    </div>
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[1px] z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/50 via-slate-900/30 to-slate-900/60 z-0"></div>
    
    <div class="container mx-auto px-4 relative z-10 text-center">
      <div class="max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 bg-white/15 border border-white/25 text-blue-300 font-bold px-4 py-1.5 rounded-full mb-4 text-xs uppercase tracking-wider backdrop-blur-md shadow-sm">
          Direct Support & Inquiries
        </div>
        <h1 class="text-4xl md:text-6xl font-black text-white mb-4 tracking-tight drop-shadow-lg">Contact Our <span class="text-blue-400">Team</span></h1>
        <p class="text-lg md:text-xl text-slate-200 font-medium max-w-2xl mx-auto drop-shadow-md">
          Whether you need a custom engineered solution or support for an existing product, our engineering team is here to assist.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-white to-transparent opacity-50"></div>
    
    <div class="container mx-auto px-4 grid grid-cols-1 lg:grid-cols-3 gap-12 relative z-10">
      <!-- Contact Info -->
      <div class="lg:col-span-1 space-y-8">
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
          <h3 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Direct Calling
          </h3>
          <p class="text-slate-800 font-semibold mb-2">Mobile 1: <a href="tel:+919825083051" class="text-blue-600 hover:underline">+91-9825083051</a></p>
          <p class="text-slate-800 font-semibold mb-2">Mobile 2: <a href="tel:+919824017215" class="text-blue-600 hover:underline">+91-9824017215</a></p>
          <p class="text-slate-800 font-semibold">Office: <a href="tel:+917922742267" class="text-blue-600 hover:underline">+91-79-22742267</a></p>
        </div>

        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
          <h3 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            Email & Timings
          </h3>
          <p class="text-slate-700 font-medium mb-3"><span class="font-semibold text-slate-900">Email:</span> <a href="mailto:elmecheng@yahoo.co.in" class="text-blue-600 hover:underline font-bold">elmecheng@yahoo.co.in</a></p>
          <p class="text-slate-700 font-medium mb-1"><span class="font-semibold text-slate-900">Working Hours:</span></p>
          <p class="text-slate-600 text-sm">Monday – Saturday: 09:30 AM – 06:00 PM</p>
          <p class="text-slate-500 text-xs mt-1">Sunday: Closed</p>
        </div>

        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
          <h3 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            Factory & Works
          </h3>
          <p class="text-slate-800 font-medium leading-relaxed">
            <strong>Elmech Engineering Company</strong><br/>
            Plot No. 83/7, G.I.D.C., Phase-I, 'F' Road,<br/>
            Nr. Kotak Mahindra Bank, Vatva,<br/>
            Ahmedabad, Gujarat – 382445, India
          </p>
        </div>
      </div>

      <!-- RFQ Form spanning 2 cols -->
      <div class="lg:col-span-2">
        <div class="h-full">
          <RFQForm />
        </div>
      </div>
    </div>
  </section>
</Layout>
