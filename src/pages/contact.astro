---
import Layout from '../layouts/Layout.astro';

const WEB3FORMS_ACCESS_KEY = "YOUR_ACCESS_KEY_HERE";
const field =
  "w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-2.5 font-medium text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-500";
---

<Layout title="Contact Us | Elmech Engineering" description="Call, visit, or write to Elmech Engineering Company in Vatva, Ahmedabad.">
  <section class="relative overflow-hidden border-b border-slate-200 bg-slate-900 py-16">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=2000&auto=format&fit=crop" alt="" class="h-full w-full object-cover brightness-90 contrast-105" />
    </div>
    <div class="absolute inset-0 z-0 bg-slate-900/50"></div>
    <div class="container relative z-10 mx-auto px-4">
      <h1 class="text-4xl font-black tracking-tight text-white md:text-6xl">Contact <span class="text-blue-400">Us</span></h1>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-20">
    <div class="container mx-auto grid grid-cols-1 gap-14 px-4 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">Contact Details</h2>
        <div class="mt-2 h-1 w-14 rounded-full bg-blue-600"></div>

        <div class="mt-8 divide-y divide-slate-200">
          <div class="flex gap-4 py-5">
            <span class="mt-0.5 text-blue-600" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </span>
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wide text-slate-900">Have a question? Call us</h3>
              <p class="mt-2"><a href="tel:+919825083051" class="font-medium text-slate-600 hover:text-blue-600">+91-9825083051</a></p>
              <p class="mt-1"><a href="tel:+919824017215" class="font-medium text-slate-600 hover:text-blue-600">+91-9824017215</a></p>
            </div>
          </div>

          <div class="flex gap-4 py-5">
            <span class="mt-0.5 text-blue-600" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </span>
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wide text-slate-900">Visit our company at</h3>
              <p class="mt-2 font-medium leading-relaxed text-slate-600">
                Plot no-83/7, G.I.D.C., Phase-I, 'F' Road,<br />
                Nr. Kotak Mahindra Bank, Vatva,<br />
                Ahmedabad
              </p>
            </div>
          </div>

          <div class="flex gap-4 py-5">
            <span class="mt-0.5 text-blue-600" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </span>
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wide text-slate-900">Send your mail</h3>
              <p class="mt-2"><a href="mailto:elmecheng@yahoo.co.in" class="font-medium text-slate-600 hover:text-blue-600">elmecheng@yahoo.co.in</a></p>
            </div>
          </div>

          <div class="flex gap-4 py-5">
            <span class="mt-0.5 text-blue-600" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </span>
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wide text-slate-900">Working hours</h3>
              <p class="mt-2 font-medium text-slate-600">Mon – Sat: 09:30 AM to 6:00 PM</p>
              <p class="mt-1 font-medium text-slate-600">Sunday: Closed</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-8">
        <h2 class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">Contact Us</h2>
        <div class="mt-2 h-1 w-14 rounded-full bg-blue-600"></div>

        <form action="https://api.web3forms.com/submit" method="POST" class="mt-8 space-y-5">
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="sr-only">Your Name</label>
              <input id="contact-name" name="name" type="text" required class={field} placeholder="Your Name*" />
            </div>
            <div>
              <label for="contact-email" class="sr-only">Email Address</label>
              <input id="contact-email" name="email" type="email" required class={field} placeholder="Email Address*" />
            </div>
            <div>
              <label for="contact-phone" class="sr-only">Phone</label>
              <input id="contact-phone" name="phone" type="tel" required class={field} placeholder="Phone*" />
            </div>
            <div>
              <label for="contact-subject" class="sr-only">Subject</label>
              <input id="contact-subject" name="subject" type="text" class={field} placeholder="Subject" />
            </div>
          </div>

          <div>
            <label for="contact-message" class="sr-only">Message</label>
            <textarea id="contact-message" name="message" rows="5" class={`${field} resize-y`} placeholder="Message"></textarea>
          </div>

          <button type="submit" class="w-full rounded-lg bg-blue-600 py-3.5 font-bold uppercase tracking-wider text-white transition-colors hover:bg-blue-700">
            Send
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>
