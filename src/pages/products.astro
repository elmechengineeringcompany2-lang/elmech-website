---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { productFamilies } from '../data/products';
---

<Layout title="Product Catalog | Elmech Engineering Company" description="Worm gearboxes, helical gear motors, parallel shaft helical gearboxes, and planetary gearboxes from Elmech Engineering.">
  <section class="relative py-20 border-b border-slate-200 overflow-hidden bg-slate-900">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=2000&auto=format&fit=crop" alt="Industrial Manufacturing Production" class="w-full h-full object-cover filter brightness-90 contrast-105" />
    </div>
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[1px] z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/60 via-slate-900/30 to-transparent z-0"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-white/15 border border-white/25 text-blue-300 font-bold px-4 py-1.5 rounded-full mb-4 text-xs uppercase tracking-wider backdrop-blur-md shadow-sm">
          Precision Engineering Catalog
        </div>
        <h1 class="text-4xl md:text-6xl font-black text-white mb-4 tracking-tight drop-shadow-lg">Product <span class="text-blue-400">Catalog</span></h1>
        <p class="text-lg md:text-xl text-slate-200 font-medium max-w-2xl drop-shadow-md">
          Worm gearboxes, helical gear motors, parallel shaft helical gearboxes, and planetary gearboxes.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white min-h-screen">
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap gap-3 mb-14">
        <span class="inline-flex items-center text-sm font-bold text-slate-700 mr-2">Jump to family:</span>
        {productFamilies.map((family) => (
          <a href={`#${family.id}`} class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-2 border border-slate-200 rounded-lg font-semibold text-sm transition-colors">
            {family.name}
          </a>
        ))}
      </div>

      <div class="space-y-20">
        {productFamilies.map((family) => (
          <section id={family.id} class="scroll-mt-28">
            <div class="mb-8 max-w-3xl">
              <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">{family.name}</h2>
              <p class="text-slate-600 font-medium mt-3 text-lg">{family.summary}</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {family.products.map((product) => (
                <ProductCard
                  name={product.name}
                  slug={product.slug}
                  category={family.name}
                  imageUrl={product.imageUrl}
                  summary={product.summary}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</Layout>
