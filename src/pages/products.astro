---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';

const allProducts = [
  {
    name: "Worm Gear Box (SU, UFR, FFMU & Adaptable)",
    slug: "worm-gear-box",
    category: "Worm Gear",
    imageUrl: "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=600&auto=format&fit=crop",
    gearRatio: "5:1 to 70:1 (Single) / up to 4900:1 (Double)",
    outputTorque: "44.5 mm to 304.8 mm C.D.",
    pdfUrl: "/downloads/catalogue"
  },
  {
    name: "Transmech Aluminum Body Reduction Gearbox",
    slug: "transmech-aluminum-worm-gear",
    category: "Worm Gear",
    imageUrl: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?q=80&w=600&auto=format&fit=crop",
    gearRatio: "NMRV Series / Multi-Mount",
    outputTorque: "Totally Dust & Oil Leak Proof",
    pdfUrl: "/downloads/catalogue"
  },
  {
    name: "Helical Geared Motor (2-Stage & 3-Stage)",
    slug: "helical-geared-motor",
    category: "Geared Motor",
    imageUrl: "https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=600&auto=format&fit=crop",
    gearRatio: "1.5 RPM to 450 RPM Output",
    outputTorque: "0.5 HP to 20.0 HP (Continuous Duty)",
    pdfUrl: "/downloads/catalogue"
  },
  {
    name: "F-Series Inline Hollow Shaft Geared Unit",
    slug: "f-series-geared-motor",
    category: "Geared Motor",
    imageUrl: "https://images.unsplash.com/photo-1616401784845-180882ba9ba8?q=80&w=600&auto=format&fit=crop",
    gearRatio: "Multi-Mount Hollow/Solid",
    outputTorque: "IP-55 TEFC Induction Duty",
    pdfUrl: "/downloads/catalogue"
  },
  {
    name: "Twin Screw Extruder Reduction Gearbox",
    slug: "twin-screw-extruder-gearbox",
    category: "Helical Gear",
    imageUrl: "https://images.unsplash.com/photo-1565261394747-0e69128f731f?q=80&w=600&auto=format&fit=crop",
    gearRatio: "Co-rotating & Counter-rotating",
    outputTorque: "294..E Series Thrust Bearings",
    pdfUrl: "/downloads/catalogue"
  },
  {
    name: "Shaft Mounted Speed Reducer (SMSR)",
    slug: "smsr-helical-gearbox",
    category: "Helical Gear",
    imageUrl: "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=600&auto=format&fit=crop",
    gearRatio: "Single & 3-Stage Helical",
    outputTorque: "Case-Hardened 18NiCrMo5",
    pdfUrl: "/downloads/catalogue"
  },
  {
    name: "Standard 3-Phase Induction Motor (Foot/Flange)",
    slug: "3-phase-induction-motor",
    category: "Motors",
    imageUrl: "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=600&auto=format&fit=crop",
    gearRatio: "415V ± 6%, 50Hz, S1 Duty",
    outputTorque: "0.12 HP to 10 HP (Frame 63-160)",
    pdfUrl: "/downloads/catalogue"
  },
  {
    name: "Special Duty Motors (Brake, Flameproof & Crane)",
    slug: "special-duty-motor",
    category: "Motors",
    imageUrl: "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=600&auto=format&fit=crop",
    gearRatio: "IS:325 / IS:1231 / IS:2223",
    outputTorque: "IP54 / IP55 Class B & F",
    pdfUrl: "/downloads/catalogue"
  }
];
---

<Layout title="Product Catalog | Elmech Engineering Company" description="Explore our full range of Worm Gearboxes, Geared Motors, Helical Extruder Reducers, and 3-Phase Induction Motors.">
  <section class="relative py-20 border-b border-slate-200 overflow-hidden bg-slate-900">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=2000&auto=format&fit=crop" alt="Industrial Manufacturing Production" class="w-full h-full object-cover filter brightness-90 contrast-105" />
    </div>
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[1px] z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/60 via-slate-900/30 to-transparent z-0"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-white/15 border border-white/25 text-blue-300 font-bold px-4 py-1.5 rounded-full mb-4 text-xs uppercase tracking-wider backdrop-blur-md shadow-sm">
          Precision Engineering Catalog
        </div>
        <h1 class="text-4xl md:text-6xl font-black text-white mb-4 tracking-tight drop-shadow-lg">Product <span class="text-blue-400">Catalog</span></h1>
        <p class="text-lg md:text-xl text-slate-200 font-medium max-w-2xl drop-shadow-md">
          Explore our complete range of heavy industrial speed reducers, geared motors, extruder gearboxes, and electric drive solutions.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white min-h-screen">
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap gap-3 mb-10">
        <span class="inline-flex items-center text-sm font-bold text-slate-700 mr-2">Filter by Category:</span>
        <a href="#all" class="bg-blue-600 text-white px-5 py-2 rounded-lg font-semibold tracking-wide text-sm shadow-sm">All Products</a>
        <a href="#worm" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-2 border border-slate-200 rounded-lg font-semibold text-sm transition-colors">Worm Gear</a>
        <a href="#geared" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-2 border border-slate-200 rounded-lg font-semibold text-sm transition-colors">Geared Motors</a>
        <a href="#helical" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-2 border border-slate-200 rounded-lg font-semibold text-sm transition-colors">Helical & Extruders</a>
        <a href="#motors" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-2 border border-slate-200 rounded-lg font-semibold text-sm transition-colors">Electric Motors</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {allProducts.map(product => (
          <ProductCard 
            name={product.name}
            slug={product.slug}
            category={product.category}
            imageUrl={product.imageUrl}
            gearRatio={product.gearRatio}
            outputTorque={product.outputTorque}
            pdfUrl={product.pdfUrl}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
