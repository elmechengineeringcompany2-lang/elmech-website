---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import RFQForm from '../components/RFQForm.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { productFamilies } from '../data/products';
---

<Layout title="Elmech Engineering Company | Industrial Gearboxes & Power Transmission Systems">
  
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-slate-900">
    <!-- Carousel Images -->
    <div id="hero-carousel" class="absolute inset-0 z-0">
      <div class="carousel-item absolute inset-0 opacity-100 transition-opacity duration-[1500ms]">
        <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=2000&auto=format&fit=crop" class="w-full h-full object-cover animate-ken-burns filter brightness-90 contrast-105" alt="Precision CNC Machining" />
      </div>
      <div class="carousel-item absolute inset-0 opacity-0 transition-opacity duration-[1500ms]">
        <img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=2000&auto=format&fit=crop" class="w-full h-full object-cover animate-ken-burns filter brightness-90 contrast-105" alt="Industrial Gears Manufacturing" />
      </div>
      <div class="carousel-item absolute inset-0 opacity-0 transition-opacity duration-[1500ms]">
        <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=2000&auto=format&fit=crop" class="w-full h-full object-cover animate-ken-burns filter brightness-90 contrast-105" alt="Heavy Manufacturing Plant" />
      </div>
      <div class="carousel-item absolute inset-0 opacity-0 transition-opacity duration-[1500ms]">
        <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?q=80&w=2000&auto=format&fit=crop" class="w-full h-full object-cover animate-ken-burns filter brightness-90 contrast-105" alt="Industrial Engineering Workshop" />
      </div>
    </div>
    
    <!-- Dark balanced overlay preserving full background visibility and text contrast -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/75 z-0"></div>
    <div class="absolute inset-0 bg-blue-950/20 z-0"></div>
    
    <div class="container mx-auto px-4 relative z-10 text-center py-32 flex flex-col items-center">
      <div class="animate-fade-in-up max-w-5xl w-full flex flex-col items-center">
        <div class="inline-flex items-center gap-2 bg-white/15 border border-white/25 text-blue-300 font-bold px-6 py-2.5 rounded-full mb-6 text-sm md:text-base tracking-widest uppercase shadow-lg backdrop-blur-md">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-400 animate-pulse"></span>
          Welcome to ELMECH &bull;
        </div>
        
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-black text-white leading-[1.1] mb-8 tracking-tighter drop-shadow-2xl">
          High Quality <br/>
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-sky-300 to-blue-200">
            Services
          </span>
        </h1>
        
        <p class="text-lg md:text-2xl text-slate-200 font-medium mb-12 leading-relaxed mx-auto max-w-3xl drop-shadow-lg">
          ELMECH has consistently embraced innovation to provide a superior level of excellence. We provide full and specific solutions for every customer.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
          <a href="#products" class="group relative px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white font-bold text-lg rounded-xl overflow-hidden transition-all hover:scale-105 shadow-2xl shadow-blue-500/40">
            <span class="relative flex items-center justify-center gap-2">
              Explore Our Range
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </span>
          </a>
          <a href="#rfq" class="group px-8 py-4 bg-white/15 hover:bg-white/25 text-white border border-white/30 font-bold text-lg rounded-xl transition-all hover:scale-105 backdrop-blur-md shadow-xl">
            Request a Quote
          </a>
        </div>
      </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center animate-bounce-slow opacity-90">
      <span class="text-white text-sm font-bold tracking-widest uppercase mb-2 drop-shadow-md">Scroll</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="drop-shadow-md"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg>
    </div>
  </section>

  <section class="py-24 bg-white border-t border-slate-200">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
            We provide full and specific solutions for our every customers.
          </h2>
          <p class="mt-6 text-lg text-slate-600 leading-relaxed font-medium">
            Ever since Elmech Engineering Company's establishment 25 years ago, we have strived to achieve new frontiers of technical excellence. Gear units are manufactured in different sizes and ratios in adaptable, SU and Fix mounting type. It is available from 44.5 mm to 304.8 mm centre distance and 5:1 to 70:1 in single stage and upto 4900:1 in double stage.
          </p>
        </div>

        <div id="home-video" class="relative overflow-hidden rounded-3xl bg-slate-100 shadow-xl border border-slate-200 aspect-video">
          <button type="button" id="home-video-poster" class="group absolute inset-0 h-full w-full" aria-label="Play Elmech gearbox video">
            <img src="/products/Extruder-duty-gearbox.png" alt="Elmech extruder duty gearbox" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <span class="absolute inset-0 bg-slate-950/20 group-hover:bg-slate-950/30 transition-colors"></span>
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-red-600 text-white shadow-lg shadow-red-600/30 transition-transform group-hover:scale-110">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
              </span>
            </span>
          </button>
        </div>
      </div>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 border-t border-slate-200 pt-12">
        <div class="flex gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-md shadow-blue-600/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path></svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">25 Years of Experience</h3>
            <p class="mt-1 text-slate-600 leading-relaxed">The great explorer the truth, the master builder human happiness one rejects ut, dislikes pleasure workers.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-md shadow-blue-600/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path><path d="m9 12 2 2 4-4"></path></svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Licensed &amp; Insured</h3>
            <p class="mt-1 text-slate-600 leading-relaxed">Must explain to you how this mistaken of idea denouncing pleasure ut and praising pain was complete account.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-md shadow-blue-600/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Honest &amp; Dependable</h3>
            <p class="mt-1 text-slate-600 leading-relaxed">Denouncing pleasure and praising pain us was born and it will give you a completed and expound great explorer.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
  <section id="products" class="py-32 bg-white border-t border-slate-200 relative">
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-blue-500/20 to-transparent"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6 animate-on-scroll">
        <div class="max-w-3xl">
          <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight">Engineered <span class="text-blue-600">Product Range</span></h2>
          <p class="text-slate-600 text-xl font-medium">Precision gear units manufactured in multiple sizes, ratios, and adaptable mounting configurations.</p>
        </div>
        <a href="/products" class="text-blue-700 hover:text-blue-800 font-bold flex items-center gap-2 group tracking-wide bg-blue-50 px-6 py-3 rounded-full border border-blue-200 hover:border-blue-300 transition-all shadow-sm">
          View All Products & Specs
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {productFamilies.map((family, i) => (
          <div class="animate-on-scroll" style={`animation-delay: ${i * 150}ms`}>
            <ProductCard
              name={family.name}
              slug={family.id}
              category="Product Family"
              imageUrl={family.imageUrl}
              summary={family.products.map((product) => product.name).join(" · ")}
              href={`/products#${family.id}`}
              ctaLabel="View Range"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden border-t border-slate-800 bg-slate-950 py-16 lg:py-24">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(37,99,235,0.28),transparent_55%)]"></div>
    <div class="container relative z-10 mx-auto px-4">
      <GoogleReviews />
    </div>
  </section>

  <section id="rfq" class="relative overflow-hidden border-t border-slate-200 bg-slate-900 py-32">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?q=80&w=2000&auto=format&fit=crop" class="h-full w-full object-cover brightness-75 contrast-110" alt="Industrial Manufacturing Workshop" />
    </div>
    <div class="absolute inset-0 z-0 bg-slate-900/50 backdrop-blur-[2px]"></div>
    <div class="absolute inset-0 z-0 bg-gradient-to-b from-slate-900/60 via-slate-900/40 to-slate-900/70"></div>

    <div class="container relative z-10 mx-auto px-4">
      <div class="mx-auto max-w-4xl overflow-hidden rounded-3xl shadow-2xl">
        <RFQForm />
      </div>
    </div>
  </section>
  
</Layout>

<style>
  /* Glassmorphism utility */
  .glass-panel {
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  /* Animations */
  @keyframes fade-in-up {
    0% {
      opacity: 0;
      transform: translateY(30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ken-burns {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.15);
    }
  }

  @keyframes bounce-slow {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(10px);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-ken-burns {
    animation: ken-burns 15s ease-out infinite alternate;
  }
  
  .animate-bounce-slow {
    animation: bounce-slow 3s infinite ease-in-out;
  }

  /* Scroll Reveal Utility */
  .reveal-active {
    animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Carousel Logic
    const items = document.querySelectorAll('.carousel-item');
    let currentIndex = 0;

    if (items.length > 0) {
      setInterval(() => {
        items[currentIndex].classList.remove('opacity-100');
        items[currentIndex].classList.add('opacity-0');
        
        currentIndex = (currentIndex + 1) % items.length;
        
        items[currentIndex].classList.remove('opacity-0');
        items[currentIndex].classList.add('opacity-100');
      }, 6000); // Change image every 6 seconds
    }

    // Scroll Reveal Logic
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-active');
          entry.target.classList.remove('opacity-0');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.animate-on-scroll').forEach((elem) => {
      elem.classList.add('opacity-0'); // Hide initially
      observer.observe(elem);
    });

    const videoPoster = document.getElementById('home-video-poster');
    const videoFrame = document.getElementById('home-video');
    videoPoster?.addEventListener('click', () => {
      if (!videoFrame) return;
      videoFrame.innerHTML = `<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube.com/embed/9wRRwtxkZuw?autoplay=1" title="Elmech gearbox on YouTube" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>`;
    });
  });
</script>
