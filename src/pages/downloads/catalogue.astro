---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Product Catalogue | Elmech Engineering" description="Download our latest industrial gearbox and power transmission product catalogue.">
  <section class="relative py-24 border-b border-slate-200 overflow-hidden bg-slate-900">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=2000&auto=format&fit=crop" alt="Industrial Manufacturing Production" class="w-full h-full object-cover filter brightness-90 contrast-105" />
    </div>
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[1px] z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/50 via-slate-900/30 to-slate-900/60 z-0"></div>
    
    <div class="container mx-auto px-4 relative z-10 text-center">
      <div class="max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 bg-white/15 border border-white/25 text-blue-300 font-bold px-4 py-1.5 rounded-full mb-4 text-xs uppercase tracking-wider backdrop-blur-md shadow-sm">
          Technical Documentation
        </div>
        <h1 class="text-4xl md:text-6xl font-black text-white mb-4 tracking-tight drop-shadow-lg">Product <span class="text-blue-400">Catalogue</span></h1>
        <p class="text-lg md:text-xl text-slate-200 font-medium max-w-2xl mx-auto drop-shadow-md">
          Access comprehensive specifications, CAD models, and engineering data for all Elmech products.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50 min-h-screen">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Worm Gear Box Downloads -->
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold">01</div>
            <div>
              <h3 class="text-xl font-bold text-slate-900">Worm Gear Box & NMRV Series</h3>
              <p class="text-slate-500 text-xs">Standard & Double Reduction Technical Sheets</p>
            </div>
          </div>
          <div class="space-y-3">
            {[
              { title: "Worm Gearbox Technical Description & Engineering", size: "1.4 MB" },
              { title: "Dimension Sheet – FFMU Horizontal & Vertical Mounting", size: "850 KB" },
              { title: "Dimension Sheet – SU Horizontal & Vertical (3- 2-25)", size: "920 KB" },
              { title: "Dimension Sheet – UFR Horizontal & Vertical Series", size: "780 KB" },
              { title: "Dimension & Mounting Positions for NMRV Aluminum Series", size: "1.1 MB" },
              { title: "Selection Chart for Single & Double Reduction NMRV", size: "1.6 MB" }
            ].map((doc) => (
              <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 hover:bg-blue-50 transition-colors border border-slate-200/60 group">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-500"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                  <span class="text-sm font-semibold text-slate-800 group-hover:text-blue-700 transition-colors">{doc.title}</span>
                </div>
                <button class="text-xs font-bold text-blue-600 hover:text-blue-800 bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-sm">
                  Download PDF
                </button>
              </div>
            ))}
          </div>
        </div>

        <!-- Helical Geared Motor Downloads -->
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold">02</div>
            <div>
              <h3 class="text-xl font-bold text-slate-900">Helical Geared Motor Series</h3>
              <p class="text-slate-500 text-xs">0.5 HP to 20.0 HP Speed Reducers</p>
            </div>
          </div>
          <div class="space-y-3">
            {[
              { title: "Helical Geared Motor Product Description & Specifications", size: "1.2 MB" },
              { title: "Dimension Sheet – 2-Stage Helical Reduction", size: "890 KB" },
              { title: "Dimension Sheet – 3-Stage Inline & Hollow Shaft", size: "1.0 MB" },
              { title: "Selection Chart – 2-Stage Geared Motor Units", size: "1.3 MB" },
              { title: "Selection Chart – 3-Stage Heavy Duty Units", size: "1.4 MB" },
              { title: "Dimensions & Shaft Specs for F-Series Gearbox", size: "950 KB" }
            ].map((doc) => (
              <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 hover:bg-blue-50 transition-colors border border-slate-200/60 group">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-500"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                  <span class="text-sm font-semibold text-slate-800 group-hover:text-blue-700 transition-colors">{doc.title}</span>
                </div>
                <button class="text-xs font-bold text-blue-600 hover:text-blue-800 bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-sm">
                  Download PDF
                </button>
              </div>
            ))}
          </div>
        </div>

        <!-- Helical & Extruder Gearbox Downloads -->
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold">03</div>
            <div>
              <h3 class="text-xl font-bold text-slate-900">Extruder & Helical Gearboxes</h3>
              <p class="text-slate-500 text-xs">Single/Twin Screw & SMSR Reducers</p>
            </div>
          </div>
          <div class="space-y-3">
            {[
              { title: "Single Screw Extruder Gearbox Description & Dimensions", size: "1.5 MB" },
              { title: "Twin Screw Extruder Gearbox Description (Co & Counter)", size: "1.8 MB" },
              { title: "Twin Extruder Gearbox Dimensions (52/20 & 65/25 Series)", size: "1.2 MB" },
              { title: "Three Stage Heavy Helical Gearbox Engineering Data", size: "1.4 MB" },
              { title: "SMSR Shaft Mounted Reducer Dimensions & Bore Specs", size: "1.1 MB" }
            ].map((doc) => (
              <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 hover:bg-blue-50 transition-colors border border-slate-200/60 group">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-500"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                  <span class="text-sm font-semibold text-slate-800 group-hover:text-blue-700 transition-colors">{doc.title}</span>
                </div>
                <button class="text-xs font-bold text-blue-600 hover:text-blue-800 bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-sm">
                  Download PDF
                </button>
              </div>
            ))}
          </div>
        </div>

        <!-- 3-Phase Electric Motor Downloads -->
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold">04</div>
            <div>
              <h3 class="text-xl font-bold text-slate-900">3-Phase Induction Motors</h3>
              <p class="text-slate-500 text-xs">IS:325, IS:1231 & IS:2223 Dimension Standards</p>
            </div>
          </div>
          <div class="space-y-3">
            {[
              { title: "3-Phase Induction Motor Engineering Description (0.12 - 10 HP)", size: "1.1 MB" },
              { title: "Dimension Sheet – Foot Mounting (B3 as per IS:1231)", size: "850 KB" },
              { title: "Dimension Sheet – Flange Mounting (B5 as per IS:2223)", size: "870 KB" },
              { title: "Dimension Sheet – Face Mounting (B14 as per IS:2223)", size: "820 KB" },
              { title: "Special Features Guide (Flameproof, Brake & Crane Duty)", size: "1.3 MB" }
            ].map((doc) => (
              <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 hover:bg-blue-50 transition-colors border border-slate-200/60 group">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-500"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                  <span class="text-sm font-semibold text-slate-800 group-hover:text-blue-700 transition-colors">{doc.title}</span>
                </div>
                <button class="text-xs font-bold text-blue-600 hover:text-blue-800 bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-sm">
                  Download PDF
                </button>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
