---
// src/components/RFQForm.astro
// Using Web3Forms endpoint as specified. Replace with your actual key.
const WEB3FORMS_ACCESS_KEY = "YOUR_ACCESS_KEY_HERE";
---

<section id="rfq" class="max-w-4xl mx-auto p-6 md:p-10 bg-white border border-slate-200 rounded-2xl shadow-xl">
  <div class="text-center mb-10">
    <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4 tracking-tight">Request a Technical Quote</h2>
    <p class="text-slate-600 font-medium">Provide your application details and our engineers will evaluate your requirements.</p>
  </div>

  <form action="https://api.web3forms.com/submit" method="POST" enctype="multipart/form-data" class="space-y-6">
    <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
    <input type="hidden" name="subject" value="New RFQ Submission - Elmech Engineering" />
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Contact Details -->
      <div class="space-y-2">
        <label for="name" class="block text-sm font-semibold text-slate-700 uppercase tracking-wide">Full Name *</label>
        <input type="text" id="name" name="name" required class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-2.5 text-slate-900 font-medium focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:bg-white transition-colors" placeholder="John Doe" />
      </div>
      <div class="space-y-2">
        <label for="email" class="block text-sm font-semibold text-slate-700 uppercase tracking-wide">Work Email *</label>
        <input type="email" id="email" name="email" required class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-2.5 text-slate-900 font-medium focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:bg-white transition-colors" placeholder="john@company.com" />
      </div>
      <div class="space-y-2 md:col-span-2">
        <label for="company" class="block text-sm font-semibold text-slate-700 uppercase tracking-wide">Company Name *</label>
        <input type="text" id="company" name="company" required class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-2.5 text-slate-900 font-medium focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:bg-white transition-colors" placeholder="Acme Manufacturing Inc." />
      </div>

      <!-- Technical Details -->
      <div class="space-y-2 md:col-span-2 mt-4 pt-6 border-t border-slate-200">
        <h3 class="text-xl font-bold text-slate-900 mb-2 uppercase tracking-wide">Technical Requirements</h3>
      </div>

      <div class="space-y-2">
        <label for="application" class="block text-sm font-semibold text-slate-700 uppercase tracking-wide">Target Application / Industry</label>
        <input type="text" id="application" name="application" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-2.5 text-slate-900 font-medium focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:bg-white transition-colors" placeholder="e.g., Overhead Crane, Mining Conveyor" />
      </div>
      <div class="space-y-2">
        <label for="ratio" class="block text-sm font-semibold text-slate-700 uppercase tracking-wide">Required Gear Ratio</label>
        <input type="text" id="ratio" name="ratio" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-2.5 text-slate-900 font-medium focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:bg-white transition-colors" placeholder="e.g., 50:1" />
      </div>
      <div class="space-y-2">
        <label for="power" class="block text-sm font-semibold text-slate-700 uppercase tracking-wide">Input Power (HP / kW)</label>
        <input type="text" id="power" name="power" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-2.5 text-slate-900 font-medium focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:bg-white transition-colors" placeholder="e.g., 75 HP" />
      </div>
      
      <!-- File Upload / Drag & Drop -->
      <div class="space-y-2 md:col-span-2">
        <label class="block text-sm font-semibold text-slate-700 uppercase tracking-wide">Engineering Drawings (.PDF, .CAD, .DWG)</label>
        <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border border-slate-300 border-dashed rounded-lg bg-slate-50 hover:bg-blue-50 hover:border-blue-400 transition-colors group cursor-pointer relative">
          <div class="space-y-2 text-center">
            <svg class="mx-auto h-10 w-10 text-slate-400 group-hover:text-blue-500 transition-colors" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
              <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="flex text-sm text-slate-600 justify-center">
              <label for="file-upload" class="relative cursor-pointer rounded-md font-bold text-blue-600 hover:text-blue-700 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-blue-500">
                <span>Upload a file</span>
                <input id="file-upload" name="attachment" type="file" class="sr-only" accept=".pdf,.dwg,.dxf,.stp,.step" />
              </label>
              <p class="pl-1">or drag and drop</p>
            </div>
            <p class="text-xs text-slate-500 font-medium">PDF, CAD, DWG up to 10MB</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Honeypot -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

    <div class="pt-6">
      <button type="submit" class="w-full bg-blue-700 hover:bg-blue-800 text-white font-bold py-4 px-6 rounded-lg transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5 uppercase tracking-wider text-lg">
        Submit Request for Quote
      </button>
    </div>
  </form>
</section>
