---
const mapsUrl = "https://www.google.com/maps/search/?api=1&query=Elmech%20Engineering%20Company%20Vatva%20Ahmedabad";

const reviews = [
  { quote: "Quality work.", rating: 4, date: "September 2024" },
  { quote: "Good service and also have good quality products.", rating: 5, date: "February 2024" },
  { quote: "So good work.", rating: 5, date: "December 2023" },
  { quote: "Very Technical & Innovative approach for Gearbox and Geared Motor Solutions.", rating: 5, date: "March 2023" },
  { quote: "Best Engineering Company.", rating: 5, date: "December 2021" },
];
---

<aside id="google-reviews" class="relative mx-auto max-w-3xl text-center text-white">
  <div class="flex flex-col items-center gap-3">
    <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="h-6 w-6 shrink-0" aria-hidden="true">
          <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"></path>
          <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 12 24 12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 16.3 4 9.6 8.3 6.3 14.7z"></path>
          <path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.3C29.2 35.1 26.7 36 24 36c-5.3 0-9.7-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"></path>
          <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-1.1 3.2-3.5 5.7-6.6 7.1l6.3 5.3C37.4 38.4 44 34 44 24c0-1.3-.1-2.7-.4-3.5z"></path>
        </svg>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-200">Google Reviews</p>
    </div>
    <p class="flex items-center gap-2 text-sm text-slate-300">
      <span class="text-3xl font-semibold tracking-tight text-white">4.4</span>
      <span>from 21 reviews</span>
    </p>
    <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-white/10">
      View on Google
    </a>
  </div>

  <div class="review-stage relative mx-auto mt-10 min-h-[240px] max-w-2xl" aria-live="polite">
    {reviews.map((review, index) => (
      <figure class:list={["review-slide", { "is-active": index === 0 }]} data-review>
        <span class="flex justify-center gap-1 text-amber-300" aria-label={`${review.rating} out of 5 stars`}>
          {Array.from({ length: 5 }, (_, star) => (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class:list={["h-5 w-5", star < review.rating ? "fill-current" : "fill-white/20"]} aria-hidden="true">
              <path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.28 3.95a1 1 0 0 0 .95.69h4.15c.97 0 1.37 1.24.59 1.81l-3.36 2.44a1 1 0 0 0-.36 1.12l1.28 3.95c.3.92-.76 1.69-1.54 1.12l-3.36-2.44a1 1 0 0 0-1.18 0l-3.36 2.44c-.78.57-1.84-.2-1.54-1.12l1.28-3.95a1 1 0 0 0-.36-1.12L2.08 9.38c-.78-.57-.38-1.81.59-1.81h4.15a1 1 0 0 0 .95-.69l1.28-3.95Z"></path>
            </svg>
          ))}
        </span>
        <blockquote class="mt-5 text-2xl font-medium leading-snug tracking-tight text-white md:text-3xl">“{review.quote}”</blockquote>
        <figcaption class="mt-6 text-sm text-slate-400">{review.date}</figcaption>
      </figure>
    ))}
  </div>

  <div class="relative mt-8 flex items-center justify-center gap-2">
    {reviews.map((review, index) => (
      <button
        type="button"
        class="review-dot h-2 rounded-full bg-white/25 transition-all"
        data-review-dot
        aria-label={`Show review from ${review.date}`}
        aria-current={index === 0 ? "true" : "false"}
      ></button>
    ))}
  </div>
</aside>

<style>
  .review-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    pointer-events: none;
  }

  .review-slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .review-dot {
    width: 0.5rem;
  }

  .review-dot[aria-current="true"] {
    width: 1.75rem;
    background: white;
  }

  @media (prefers-reduced-motion: reduce) {
    .review-slide {
      transition: none;
    }
  }
</style>

<script>
  const root = document.getElementById("google-reviews");
  if (root) {
    root._stopReviews?.();

    const slides = [...root.querySelectorAll("[data-review]")];
    const dots = [...root.querySelectorAll("[data-review-dot]")];
    let index = Math.max(0, slides.findIndex((slide) => slide.classList.contains("is-active")));
    let timer = 0;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const show = (next) => {
      slides.forEach((slide) => slide.getAnimations().forEach((animation) => animation.cancel()));
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => slide.classList.toggle("is-active", slideIndex === index));
      dots.forEach((dot, dotIndex) => {
        if (dotIndex === index) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };

    const start = () => {
      window.clearInterval(timer);
      if (reduceMotion || slides.length < 2) return;
      timer = window.setInterval(() => show(index + 1), 4200);
    };

    dots.forEach((dot, dotIndex) => {
      dot.addEventListener("click", () => {
        show(dotIndex);
        start();
      });
    });

    root.addEventListener("mouseenter", () => window.clearInterval(timer));
    root.addEventListener("mouseleave", start);
    show(index);
    start();
    root._stopReviews = () => window.clearInterval(timer);
  }
</script>
